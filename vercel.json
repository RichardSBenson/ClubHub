{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/check-dependencies.mjs && node tools/check-wiring.mjs && node tools/migrate.mjs && node packages/site/build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/enter/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/trial/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/r/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/v/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/checkin/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/enquire/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/cron/publish",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/api/index"
    },
    {
      "source": "/signin",
      "destination": "/api/index"
    },
    {
      "source": "/signin/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/signout",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index"
    },
    {
      "source": "/unsubscribe/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/cron/renewals",
      "destination": "/api/index"
    },
    {
      "source": "/me",
      "destination": "/api/index"
    },
    {
      "source": "/me/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/search",
      "destination": "/api/index"
    },
    {
      "source": "/bootstrap/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/o/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/p/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/a/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/try/:path*",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/cron/renewals",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/cron/publish",
      "schedule": "0 17 * * *"
    }
  ]
}
